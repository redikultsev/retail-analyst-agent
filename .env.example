# Copy this file to .env and fill in the values. Never commit .env.

# Required. Your Google Cloud project id, used to run BigQuery jobs.
GOOGLE_CLOUD_PROJECT=

# Required. Gemini API key from Google AI Studio.
GOOGLE_API_KEY=

# Optional. Folder for the local database with user profiles. Default: ./data
DATA_DIR=

# Optional limits. Defaults: 1 GB read per query, 30 seconds, 20000 characters and 500 rows per result.
# QUERY_TIMEOUT_S takes 10 to 600: the BigQuery client does not give up sooner than about 10 seconds.
QUERY_MAX_BYTES=
QUERY_TIMEOUT_S=
RESULT_MAX_CHARS=
RESULT_MAX_ROWS=

# Optional. Without these, traces are written to a local file.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
