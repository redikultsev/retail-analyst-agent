# Copy this file to .env and fill in the values. Never commit .env.

# Required. Your Google Cloud project id, used to run BigQuery jobs.
GOOGLE_CLOUD_PROJECT=

# Required. Gemini API key from Google AI Studio.
GOOGLE_API_KEY=

# Optional. Without these, traces are written to a local file.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
